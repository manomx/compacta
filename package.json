{
  "name": "compacta",
  "version": "1.0.4",
  "description": "Prepare conversation context in the background. A native macOS companion for coding agents.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Armando Marroquín Benavides",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manomx/compacta.git"
  },
  "bugs": {
